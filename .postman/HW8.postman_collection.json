              "pm.test(\"Статус 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var result = responseData.content[ 0 ].notificationType",
              "",
              "",
              "// Extract quantity values from all items in content array",
              "const quantities = responseData.content.map(item => item.quantity);",
              "",
              "// Log quantities to console",
              "console.log(\"Extracted quantities:\", quantities);",
              "",
              "// Store as collection variable for use in other requests",
              "pm.collectionVariables.set(\"catalogQuantities\", JSON.stringify(quantities));",
              "",
              "// Display quantities in a readable format",
              "console.log(\"Quantity details:\");",
              "responseData.content.forEach((item, index) => {",
              "    console.log(`Item ${index + 1} (${item.product.name.trim()}): ${item.quantity} units`);",
              "    if (item.product.id == 2) {        ",
              "            pm.collectionVariables.set(\"product2QuanAct\", item.quantity);",
              "    }",
              "    if (item.product.id == 3) {",
              "        pm.collectionVariables.set(\"product3QuanAct\", item.quantity);",
              "    }    ",
              "});",
              "",
              "pm.test(\"Product 2 quantity restored OK\", function () {",
              "    pm.expect(pm.collectionVariables.get(\"product2Quan\")).to.equal(",
              "        pm.collectionVariables.get(\"product2QuanAct\"));            ",
              "});",
              "",
              "pm.test(\"Product 3 quantity restored OK\", function () {",
              "    pm.expect(pm.collectionVariables.get(\"product3Quan\")).to.equal(",
              "        pm.collectionVariables.get(\"product3QuanAct\"));            ",
              "});"
